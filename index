<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>우리 학급 도전성취 프로그램 (오운완 & 독서마라톤)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter & Noto Sans KR -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Noto Sans KR', 'sans-serif'],
                    },
                    colors: {
                        workout: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        },
                        reading: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar and smooth transitions */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .progress-bar-animated {
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen text-slate-800 antialiased flex flex-col">

    <!-- Top Header Navigation -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- App Title -->
            <div class="flex items-center space-x-3">
                <div class="bg-gradient-to-tr from-amber-500 to-emerald-500 text-white p-2 rounded-xl shadow-sm">
                    <i class="fa-solid fa-trophy text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">
                        학급 도전성취 프로그램
                    </h1>
                    <p class="text-xs text-slate-500 hidden sm:block">🔥 오운완 (오늘 운동 완료) & 📚 독서 마라톤</p>
                </div>
            </div>

            <!-- Header Action Controls -->
            <div class="flex items-center space-x-2 sm:space-x-3">
                <!-- Data Sync Status Badge -->
                <div id="sync-status" class="flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                    <span class="hidden md:inline">연결 중...</span>
                </div>

                <!-- Mode Switcher -->
                <div class="bg-slate-100 p-1 rounded-lg flex text-xs font-medium border border-slate-200">
                    <button id="btn-mode-student" onclick="switchMode('student')" class="px-3 py-1.5 rounded-md transition-all shadow-sm bg-white text-slate-800 font-semibold">
                        <i class="fa-solid fa-users mr-1"></i>학생 전광판
                    </button>
                    <button id="btn-mode-teacher" onclick="requestTeacherAccess()" class="px-3 py-1.5 rounded-md transition-all text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-user-gear mr-1"></i>교사 관리
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Banner / Stats Overview Card -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Total Class Stats -->
            <div class="bg-gradient-to-br from-indigo-900 to-slate-800 rounded-2xl p-5 text-white shadow-lg relative overflow-hidden flex flex-col justify-between">
                <div class="absolute -right-4 -bottom-4 opacity-10 text-9xl">
                    <i class="fa-solid fa-award"></i>
                </div>
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-indigo-300">Class Progress</span>
                    <h2 class="text-xl font-bold mt-1">우리 학급 도전 목표 현황</h2>
                </div>
                <div class="mt-4 grid grid-cols-2 gap-2 text-center">
                    <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5">
                        <p class="text-xs text-indigo-200">총 학생 수</p>
                        <p id="stat-student-count" class="text-2xl font-black text-white">0명</p>
                    </div>
                    <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5">
                        <p class="text-xs text-indigo-200">평균 달성률</p>
                        <p id="stat-avg-progress" class="text-2xl font-black text-amber-300">0%</p>
                    </div>
                </div>
            </div>

            <!-- Workout Summary -->
            <div class="bg-gradient-to-br from-orange-500 to-amber-600 rounded-2xl p-5 text-white shadow-lg relative overflow-hidden flex flex-col justify-between">
                <div class="absolute -right-2 -bottom-2 opacity-15 text-8xl">
                    <i class="fa-solid fa-fire-flame-curved"></i>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-white/20 text-white">
                            <i class="fa-solid fa-dumbbell mr-1"></i> 오운완
                        </span>
                        <h3 class="text-lg font-bold mt-1">오늘 운동 완료</h3>
                    </div>
                    <span id="stat-workout-today-count" class="bg-white text-orange-600 font-bold px-2.5 py-1 rounded-full text-xs shadow">
                        오늘 0명 달성
                    </span>
                </div>
                <div class="mt-4">
                    <div class="flex justify-between text-xs text-orange-100 mb-1">
                        <span>학급 누적 운동 횟수</span>
                        <span id="stat-workout-total" class="font-bold text-white">0회</span>
                    </div>
                    <div class="w-full bg-black/20 rounded-full h-2.5 overflow-hidden">
                        <div id="stat-workout-bar" class="bg-white h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Reading Summary -->
            <div class="bg-gradient-to-br from-emerald-600 to-teal-700 rounded-2xl p-5 text-white shadow-lg relative overflow-hidden flex flex-col justify-between">
                <div class="absolute -right-2 -bottom-2 opacity-15 text-8xl">
                    <i class="fa-solid fa-book-open"></i>
                </div>
                <div class="flex justify-between items-start">
                    <div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-white/20 text-white">
                            <i class="fa-solid fa-book mr-1"></i> 독서 마라톤
                        </span>
                        <h3 class="text-lg font-bold mt-1">학년도 독서 목표</h3>
                    </div>
                    <span id="stat-reading-completers" class="bg-white text-emerald-700 font-bold px-2.5 py-1 rounded-full text-xs shadow">
                        완주자 0명
                    </span>
                </div>
                <div class="mt-4">
                    <div class="flex justify-between text-xs text-emerald-100 mb-1">
                        <span>학급 누적 독서량</span>
                        <span id="stat-reading-total" class="font-bold text-white">0권</span>
                    </div>
                    <div class="w-full bg-black/20 rounded-full h-2.5 overflow-hidden">
                        <div id="stat-reading-bar" class="bg-white h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Class Achievement Reward Section -->
        <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 rounded-2xl p-5 text-white shadow-lg relative overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                <div class="flex items-center space-x-2">
                    <div class="bg-white/20 p-2 rounded-xl backdrop-blur-md">
                        <i class="fa-solid fa-gift text-2xl text-amber-100"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-extrabold flex items-center gap-2">
                            <span>🎉 우리 학급 종합 보상 마일스톤</span>
                        </h2>
                        <p class="text-xs text-amber-100">학급 전체 평균 달성률에 따라 학급 보상을 해제해요!</p>
                    </div>
                </div>
                <!-- Teacher Edit Rewards Button -->
                <button id="btn-edit-rewards" onclick="openRewardsModal()" class="hidden px-3 py-1.5 bg-white/20 hover:bg-white/30 rounded-xl text-xs font-bold transition-all items-center space-x-1 backdrop-blur-md border border-white/30 self-start sm:self-auto">
                    <i class="fa-solid fa-pen"></i>
                    <span>보상 수정</span>
                </button>
            </div>

            <!-- Reward Progress Steps -->
            <div id="reward-milestone-list" class="grid grid-cols-2 md:grid-cols-4 gap-3 relative z-10">
                <!-- Dynamically Rendered Milestones -->
            </div>
        </div>

        <!-- Hall of Fame Showcase Section -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <div class="flex items-center space-x-2">
                    <div class="bg-amber-100 text-amber-700 p-2 rounded-xl font-bold">
                        <i class="fa-solid fa-crown text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">🏆 목표 달성 명예의 전당</h3>
                        <p class="text-xs text-slate-500">도전 목표를 100% 완주한 빛나는 자랑스러운 명단입니다.</p>
                    </div>
                </div>
                <div class="text-xs font-bold px-3 py-1 bg-amber-50 text-amber-700 rounded-full border border-amber-200" id="hall-of-fame-count-badge">
                    총 0명 완주
                </div>
            </div>

            <!-- Hall of Fame Category Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Double Crown Achievers -->
                <div class="bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-xl p-4">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-amber-800 flex items-center">
                            <i class="fa-solid fa-trophy mr-1 text-amber-500"></i> 👑 더블 크라운 (양쪽 완주)
                        </span>
                        <span id="badge-count-double" class="text-[10px] bg-amber-200 text-amber-900 font-extrabold px-2 py-0.5 rounded-full">0명</span>
                    </div>
                    <div id="hall-list-double" class="space-y-1.5 text-xs">
                        <div class="text-slate-400 text-center py-4 text-xs">아직 더블 크라운 달성자가 없습니다.</div>
                    </div>
                </div>

                <!-- Workout Achievers -->
                <div class="bg-orange-50/60 border border-orange-200 rounded-xl p-4">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-orange-800 flex items-center">
                            <i class="fa-solid fa-fire mr-1 text-orange-500"></i> 🔥 오운완 목표 완주자
                        </span>
                        <span id="badge-count-workout" class="text-[10px] bg-orange-200 text-orange-900 font-extrabold px-2 py-0.5 rounded-full">0명</span>
                    </div>
                    <div id="hall-list-workout" class="space-y-1.5 text-xs">
                        <div class="text-slate-400 text-center py-4 text-xs">아직 오운완 완주자가 없습니다.</div>
                    </div>
                </div>

                <!-- Reading Achievers -->
                <div class="bg-emerald-50/60 border border-emerald-200 rounded-xl p-4">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-emerald-800 flex items-center">
                            <i class="fa-solid fa-book-open mr-1 text-emerald-500"></i> 📚 독서 마라톤 완주자
                        </span>
                        <span id="badge-count-reading" class="text-[10px] bg-emerald-200 text-emerald-900 font-extrabold px-2 py-0.5 rounded-full">0명</span>
                    </div>
                    <div id="hall-list-reading" class="space-y-1.5 text-xs">
                        <div class="text-slate-400 text-center py-4 text-xs">아직 독서 마라톤 완주자가 없습니다.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter & Search Controls -->
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
            <!-- Filter Tabs -->
            <div class="flex items-center space-x-1 w-full sm:w-auto overflow-x-auto pb-1 sm:pb-0">
                <button onclick="setFilter('all')" id="filter-btn-all" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-white transition-colors whitespace-nowrap">
                    전체 보기
                </button>
                <button onclick="setFilter('workout')" id="filter-btn-workout" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors whitespace-nowrap">
                    🔥 오운완 순
                </button>
                <button onclick="setFilter('reading')" id="filter-btn-reading" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors whitespace-nowrap">
                    📚 독서 순
                </button>
            </div>

            <!-- Search Bar & Teacher Controls -->
            <div class="flex items-center space-x-2 w-full sm:w-auto">
                <div class="relative flex-1 sm:w-64">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="search-input" oninput="renderStudentList()" placeholder="학생 이름 검색..." class="w-full pl-9 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all">
                </div>
                <!-- Add Student Button (Visible in Teacher Mode) -->
                <button id="btn-add-student" onclick="openAddStudentModal()" class="hidden px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold transition-colors items-center space-x-1 whitespace-nowrap shadow-sm">
                    <i class="fa-solid fa-plus"></i>
                    <span>학생 등록</span>
                </button>
            </div>
        </div>

        <!-- Student Cards Grid Container -->
        <div id="student-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- Loading Placeholder State -->
            <div class="col-span-full py-16 text-center text-slate-400 bg-white rounded-2xl border border-dashed border-slate-300">
                <i class="fa-solid fa-spinner fa-spin text-3xl mb-3 text-indigo-500"></i>
                <p class="text-sm font-medium">학급 데이터를 불러오는 중입니다...</p>
            </div>
        </div>

        <!-- Teacher Mode Activity History Panel (Teacher Only) -->
        <div id="teacher-history-panel" class="hidden bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-800 flex items-center">
                    <i class="fa-solid fa-clock-rotate-left mr-2 text-indigo-600"></i>최근 인증 및 수정 기록
                </h3>
                <span class="text-xs text-slate-400">실시간 동기화됨</span>
            </div>
            <div id="activity-log-list" class="space-y-2 max-h-48 overflow-y-auto text-xs text-slate-600 pr-1">
                <div class="text-slate-400 text-center py-4">기록된 인증 로그가 없습니다.</div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-400">
            <p>도전성취프로그램 - 오늘운동완료 & 독서마라톤 ⓒ 학급 운영 지원 도구</p>
        </div>
    </footer>

    <!-- MODAL: Add / Edit Student Modal -->
    <div id="modal-student" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 transform transition-all">
            <div class="flex justify-between items-center mb-5">
                <h3 id="modal-student-title" class="text-lg font-bold text-slate-900">학생 정보 등록</h3>
                <button onclick="closeStudentModal()" class="text-slate-400 hover:text-slate-600 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="form-student" onsubmit="handleSaveStudent(event)" class="space-y-4">
                <input type="hidden" id="student-id" value="">
                
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">학생 이름 <span class="text-rose-500">*</span></label>
                    <input type="text" id="student-name" required placeholder="예: 김철수" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-orange-700 mb-1">🔥 오운완 목표 횟수</label>
                        <div class="relative">
                            <input type="number" id="student-target-workout" min="1" max="365" required value="50" class="w-full px-3 py-2 border border-orange-200 bg-orange-50/50 rounded-xl text-sm font-semibold text-orange-900 focus:ring-2 focus:ring-orange-500 focus:outline-none">
                            <span class="absolute right-3 top-2.5 text-xs text-orange-400 font-medium">회</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-emerald-700 mb-1">📚 독서 목표 권수</label>
                        <div class="relative">
                            <input type="number" id="student-target-reading" min="1" max="200" required value="20" class="w-full px-3 py-2 border border-emerald-200 bg-emerald-50/50 rounded-xl text-sm font-semibold text-emerald-900 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            <span class="absolute right-3 top-2.5 text-xs text-emerald-400 font-medium">권</span>
                        </div>
                    </div>
                </div>

                <div class="pt-3 flex space-x-2">
                    <button type="button" onclick="closeStudentModal()" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-colors">
                        취소
                    </button>
                    <button type="submit" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition-colors shadow-md">
                        저장하기
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: Student Detail / History Log -->
    <div id="modal-detail" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 max-h-[90vh] flex flex-col">
            <div class="flex justify-between items-start mb-4 border-b border-slate-100 pb-3">
                <div>
                    <span id="detail-badge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-700">도전 현황</span>
                    <h3 id="detail-student-name" class="text-xl font-black text-slate-900 mt-1">학생 이름</h3>
                </div>
                <button onclick="closeDetailModal()" class="text-slate-400 hover:text-slate-600 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="overflow-y-auto space-y-4 pr-1 flex-1">
                <!-- Stats Overview -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-orange-50 border border-orange-200 rounded-xl p-3">
                        <div class="text-xs font-bold text-orange-800 flex items-center gap-1 mb-1">
                            <i class="fa-solid fa-fire text-orange-500"></i> 오운완 현황
                        </div>
                        <div id="detail-workout-stat" class="text-lg font-black text-orange-900">0 / 50회</div>
                        <div class="w-full bg-orange-200 h-2 rounded-full mt-2 overflow-hidden">
                            <div id="detail-workout-bar" class="bg-orange-500 h-2 rounded-full" style="width:0%"></div>
                        </div>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3">
                        <div class="text-xs font-bold text-emerald-800 flex items-center gap-1 mb-1">
                            <i class="fa-solid fa-book text-emerald-500"></i> 독서 마라톤 현황
                        </div>
                        <div id="detail-reading-stat" class="text-lg font-black text-emerald-900">0 / 20권</div>
                        <div class="w-full bg-emerald-200 h-2 rounded-full mt-2 overflow-hidden">
                            <div id="detail-reading-bar" class="bg-emerald-500 h-2 rounded-full" style="width:0%"></div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity History -->
                <div>
                    <h4 class="text-xs font-bold text-slate-700 mb-2 flex items-center gap-1">
                        <i class="fa-solid fa-clock-rotate-left text-slate-400"></i> 개인 인증 기록
                    </h4>
