            <p id="dialog-message" class="text-xs text-slate-600 mb-5 leading-relaxed">메시지 내용</p>
            <div id="dialog-actions" class="flex space-x-2">
                <button id="dialog-btn-cancel" onclick="closeCustomDialog(false)" class="flex-1 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold">
                    취소
                </button>
                <button id="dialog-btn-confirm" onclick="closeCustomDialog(true)" class="flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold">
                    확인
                </button>
            </div>
        </div>
    </div>

    <!-- Firebase Script Execution -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, addDoc, updateDoc, deleteDoc, onSnapshot, increment } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration & Global Setup
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'class-challenge-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-api-key",
            authDomain: "demo-app.firebaseapp.com",
            projectId: "demo-app",
            storageBucket: "demo-app.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abcdef"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // Firestore Public Collections Paths
        const STUDENTS_COL = collection(db, 'artifacts', appId, 'public', 'data', 'students');
        const LOGS_COL = collection(db, 'artifacts', appId, 'public', 'data', 'logs');
        const SETTINGS_DOC = doc(db, 'artifacts', appId, 'public', 'data', 'settings', 'rewards');

        // Application Global State
        window.state = {
            currentUser: null,
            isTeacherMode: false,
            teacherPin: '1234',
            students: [],
            logs: [],
            rewards: {
                25: '칭찬 스티커 2배 데이 ⭐️',
                50: '즐거운 과자 파티 🎉',
                75: '자율 시간 1시간 & 게임 데이 🎮',
                100: '학급 영화 관람 & 파티 🎬🍕'
            },
            currentFilter: 'all', // 'all', 'workout', 'reading'
            dialogCallback: null
        };

        // Initialize App & Auth
        async function initApp() {
            try {
                const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                let userCred;
                if (initialAuthToken) {
                    userCred = await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    userCred = await signInAnonymously(auth);
                }
                window.state.currentUser = userCred.user;
                
                // Update UI Connection Status
                const statusEl = document.getElementById('sync-status');
                if (statusEl) {
                    statusEl.className = "flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200";
                    statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="hidden md:inline">실시간 연결됨</span>`;
                }

                // Subscribe to Rewards Settings
                onSnapshot(SETTINGS_DOC, (snapshot) => {
                    if (snapshot.exists()) {
                        window.state.rewards = { ...window.state.rewards, ...snapshot.data() };
                    }
                    renderStatsSummary();
                }, (error) => {
                    console.error("Rewards sync error:", error);
                });

                // Subscribe to Students Collection
                onSnapshot(STUDENTS_COL, (snapshot) => {
                    const students = [];
                    snapshot.forEach((doc) => {
                        students.push({ id: doc.id, ...doc.data() });
                    });
                    window.state.students = students;
                    renderAll();
                }, (error) => {
                    console.error("Students sync error:", error);
                    showToast("데이터 동기화 중 오류가 발생했습니다.", "error");
                });

                // Subscribe to Activity Logs Collection
                onSnapshot(LOGS_COL, (snapshot) => {
                    const logs = [];
                    snapshot.forEach((doc) => {
                        logs.push({ id: doc.id, ...doc.data() });
                    });
                    logs.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                    window.state.logs = logs;
                    renderActivityLogs();
                }, (error) => {
                    console.error("Logs sync error:", error);
                });

            } catch (err) {
                console.error("Auth / Init error:", err);
                const statusEl = document.getElementById('sync-status');
                if (statusEl) {
                    statusEl.className = "flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200";
                    statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span><span class="hidden md:inline">오프라인 모드</span>`;
                }
            }
        }

        // Render All UI Components based on current state
        window.renderAll = function() {
            renderStudentList();
            renderStatsSummary();
            renderHallOfFame();
            renderActivityLogs();
        };

        // Render Recent Activity Logs
        window.renderActivityLogs = function() {
            const listEl = document.getElementById('activity-log-list');
            if (!listEl) return;

            const logs = window.state.logs || [];
            if (logs.length === 0) {
                listEl.innerHTML = `<div class="text-slate-400 text-center py-4 text-xs">기록된 인증 로그가 없습니다.</div>`;
                return;
            }

            listEl.innerHTML = logs.slice(0, 25).map(log => {
                let badgeClass = 'bg-slate-100 text-slate-700';
                let icon = 'fa-info-circle';

                if (log.type === 'workout') {
                    badgeClass = 'bg-orange-100 text-orange-800';
                    icon = 'fa-dumbbell';
                } else if (log.type === 'reading') {
                    badgeClass = 'bg-emerald-100 text-emerald-800';
                    icon = 'fa-book';
                } else if (log.type === 'system') {
                    badgeClass = 'bg-indigo-100 text-indigo-800';
                    icon = 'fa-user-plus';
                }

                return `
                    <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                        <div class="flex items-center space-x-2 overflow-hidden">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${badgeClass} shrink-0 flex items-center gap-1">
                                <i class="fa-solid ${icon}"></i> ${escapeHtml(log.studentName || '학급')}
                            </span>
                            <span class="text-slate-700 truncate font-medium">${escapeHtml(log.message)}</span>
                        </div>
                        <span class="text-[10px] text-slate-400 shrink-0 ml-2">${formatDateTime(log.timestamp)}</span>
                    </div>
                `;
            }).join('');
        };

        // Render Student Cards Grid
        window.renderStudentList = function() {
            const grid = document.getElementById('student-grid');
            if (!grid) return;

            let students = [...window.state.students];
            const searchKeyword = (document.getElementById('search-input')?.value || '').trim().toLowerCase();
            const isTeacher = window.state.isTeacherMode;
            const todayStr = getTodayString();

            // Search filter
            if (searchKeyword) {
                students = students.filter(s => s.name && s.name.toLowerCase().includes(searchKeyword));
            }

            // Category filter / Sorting
            if (window.state.currentFilter === 'workout') {
                students.sort((a, b) => (b.workoutCount || 0) - (a.workoutCount || 0));
            } else if (window.state.currentFilter === 'reading') {
                students.sort((a, b) => (b.readingCount || 0) - (a.readingCount || 0));
            } else {
                students.sort((a, b) => (a.name || '').localeCompare(b.name || '', 'ko'));
            }

            if (students.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-400 bg-white rounded-2xl border border-dashed border-slate-200">
                        <i class="fa-solid fa-users-slash text-3xl mb-2 text-slate-300"></i>
                        <p class="text-sm font-medium text-slate-600">등록되었거나 조건에 맞는 학생이 없습니다.</p>
                        ${isTeacher ? '<p class="text-xs text-indigo-600 mt-1 cursor-pointer font-bold" onclick="openAddStudentModal()">+ 새 학생 등록하기</p>' : ''}
                    </div>
                `;
                return;
            }

            grid.innerHTML = students.map(s => {
                const wCount = s.workoutCount || 0;
                const wTarget = s.targetWorkout || 50;
                const wPct = Math.min(100, Math.round((wCount / wTarget) * 100));

                const rCount = s.readingCount || 0;
                const rTarget = s.targetReading || 20;
                const rPct = Math.min(100, Math.round((rCount / rTarget) * 100));

                const isWorkoutDoneToday = s.lastWorkoutDate === todayStr;
                const isDoubleCrown = wPct >= 100 && rPct >= 100;

                return `
                    <div class="bg-white rounded-2xl p-5 shadow-sm hover:shadow-md border border-slate-200 transition-all flex flex-col justify-between relative overflow-hidden group">
                        <!-- Card Header -->
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center space-x-2">
                                    <h3 class="text-base font-extrabold text-slate-900 hover:text-indigo-600 cursor-pointer flex items-center gap-1.5" onclick="openDetailModal('${s.id}')">
                                        ${escapeHtml(s.name)}
                                    </h3>
                                    ${isDoubleCrown ? '<span class="text-xs bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded-full border border-amber-300">👑 더블 크라운</span>' : ''}
                                </div>

                                ${isTeacher ? `
                                    <div class="flex items-center space-x-1">
                                        <button onclick="openEditStudentModal('${s.id}')" title="수정" class="p-1.5 text-slate-400 hover:text-indigo-600 rounded-lg hover:bg-slate-100 transition-colors">
                                            <i class="fa-solid fa-pen-to-square text-xs"></i>
                                        </button>
                                        <button onclick="deleteStudent('${s.id}')" title="삭제" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-slate-100 transition-colors">
                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                        </button>
                                    </div>
                                ` : `
                                    <button onclick="openDetailModal('${s.id}')" class="text-xs text-slate-400 hover:text-slate-600">
                                        기록 <i class="fa-solid fa-angle-right text-[10px]"></i>
                                    </button>
                                `}
                            </div>

                            <!-- Goal 1: Workout (오운완) -->
                            <div class="bg-orange-50/70 border border-orange-100 rounded-xl p-3 mb-3">
                                <div class="flex items-center justify-between text-xs font-bold text-orange-900 mb-1">
                                    <span class="flex items-center gap-1">
                                        <i class="fa-solid fa-dumbbell text-orange-500"></i> 🔥 오운완
                                    </span>
                                    <span>${wCount} / ${wTarget}회 (${wPct}%)</span>
                                </div>
                                <div class="w-full bg-orange-200/60 h-2 rounded-full overflow-hidden mb-2">
                                    <div class="bg-orange-500 h-2 rounded-full transition-all duration-500" style="width: ${wPct}%"></div>
                                </div>

                                <!-- Workout Action Controls (Teacher Only) -->
                                ${isTeacher ? `
                                    <div class="flex items-center justify-between mt-2 pt-1 border-t border-orange-200/40">
                                        <span class="text-[10px] ${isWorkoutDoneToday ? 'text-emerald-700 font-bold' : 'text-slate-400'}">
                                            ${isWorkoutDoneToday ? '✅ 오늘 인증 완료' : '오늘 미인증'}
                                        </span>
                                        <button onclick="handleWorkout('${s.id}')" class="px-2.5 py-1 bg-orange-500 hover:bg-orange-600 active:scale-95 text-white rounded-lg text-xs font-bold transition-all shadow-xs flex items-center gap-1">
                                            <i class="fa-solid fa-check"></i> 오늘 운동 인증 (+1)
                                        </button>
                                    </div>
                                ` : `
                                    <div class="text-[10px] text-right text-slate-400">
                                        ${isWorkoutDoneToday ? '🔥 오늘 운동 인증을 완료했습니다!' : '오늘 운동 후 교사에게 인증하세요.'}
                                    </div>
                                `}
                            </div>

                            <!-- Goal 2: Reading Marathon (독서 마라톤) -->
                            <div class="bg-emerald-50/70 border border-emerald-100 rounded-xl p-3">
                                <div class="flex items-center justify-between text-xs font-bold text-emerald-900 mb-1">
                                    <span class="flex items-center gap-1">
                                        <i class="fa-solid fa-book text-emerald-600"></i> 📚 독서 마라톤
                                    </span>
                                    <span>${rCount} / ${rTarget}권 (${rPct}%)</span>
                                </div>
                                <div class="w-full bg-emerald-200/60 h-2 rounded-full overflow-hidden mb-2">
                                    <div class="bg-emerald-600 h-2 rounded-full transition-all duration-500" style="width: ${rPct}%"></div>
                                </div>

                                <!-- Reading Action Controls (Teacher Only) -->
                                ${isTeacher ? `
                                    <div class="flex items-center justify-end space-x-1.5 mt-2 pt-1 border-t border-emerald-200/40">
                                        <button onclick="handleReadingPrompt('${s.id}')" class="px-2 py-1 bg-white hover:bg-emerald-100 text-emerald-800 border border-emerald-200 rounded-lg text-[11px] font-bold transition-all">
                                            직접 입력
                                        </button>
                                        <button onclick="handleReading('${s.id}', 1)" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white rounded-lg text-xs font-bold transition-all shadow-xs flex items-center gap-1">
                                            <i class="fa-solid fa-plus"></i> 1권 인증
                                        </button>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        };

        // Teacher Mode Switching
        window.switchMode = function(mode) {
            if (mode === 'teacher') {
                window.requestTeacherAccess();
            } else {
                window.state.isTeacherMode = false;
                updateTeacherModeUI();
                showToast("학생 전광판 모드로 전환되었습니다.", "info");
            }
        };

        window.requestTeacherAccess = function() {
            if (window.state.isTeacherMode) {
                showToast("이미 교사 관리 모드 상태입니다.", "info");
                return;
            }
            document.getElementById('pin-input').value = '';
            document.getElementById('modal-pin').classList.remove('hidden');
        };

        window.closePinModal = function() {
            document.getElementById('modal-pin').classList.add('hidden');
        };

        window.handleCheckPin = function(e) {
            e.preventDefault();
            const input = document.getElementById('pin-input').value.trim();
            if (input === window.state.teacherPin) {
                window.state.isTeacherMode = true;
                closePinModal();
                updateTeacherModeUI();
                showToast("교사 관리자 모드로 인증되었습니다.", "success");
            } else {
                showToast("비밀번호가 올바르지 않습니다. (기본: 1234)", "error");
            }
        };

        // Student Modal Handlers
        window.openAddStudentModal = function() {
            document.getElementById('modal-student-title').textContent = "신규 학생 등록";
            document.getElementById('student-id').value = "";
            document.getElementById('student-name').value = "";
            document.getElementById('student-target-workout').value = "50";
            document.getElementById('student-target-reading').value = "20";
            document.getElementById('modal-student').classList.remove('hidden');
        };

        window.openEditStudentModal = function(id) {
            const student = window.state.students.find(s => s.id === id);
            if (!student) return;

            document.getElementById('modal-student-title').textContent = "학생 정보 및 목표 수정";
            document.getElementById('student-id').value = student.id;
            document.getElementById('student-name').value = student.name || "";
            document.getElementById('student-target-workout').value = student.targetWorkout || 50;
            document.getElementById('student-target-reading').value = student.targetReading || 20;
            document.getElementById('modal-student').classList.remove('hidden');
        };

        window.closeStudentModal = function() {
            document.getElementById('modal-student').classList.add('hidden');
        };

        window.handleSaveStudent = async function(e) {
            e.preventDefault();
            const id = document.getElementById('student-id').value;
            const name = document.getElementById('student-name').value.trim();
            const targetWorkout = parseInt(document.getElementById('student-target-workout').value) || 50;
            const targetReading = parseInt(document.getElementById('student-target-reading').value) || 20;

            if (!name) return;

            try {
                if (id) {
                    const docRef = doc(STUDENTS_COL, id);
                    await updateDoc(docRef, { name, targetWorkout, targetReading });
                    await logActivity('system', name, `학생 정보 수정 (${name})`);
                    showToast(`${name} 학생 정보가 수정되었습니다.`, "success");
                } else {
                    await addDoc(STUDENTS_COL, {
                        name,
                        targetWorkout,
                        targetReading,
                        workoutCount: 0,
                        readingCount: 0,
                        lastWorkoutDate: "",
                        createdAt: new Date().toISOString()
                    });
                    await logActivity('system', name, `신규 학생 등록 (${name})`);
                    showToast(`${name} 학생이 등록되었습니다.`, "success");
                }
                closeStudentModal();
            } catch (err) {
                console.error("Save student error:", err);
                showToast("학생 정보 저장 중 오류가 발생했습니다.", "error");
            }
        };

        window.deleteStudent = async function(id) {
            const student = window.state.students.find(s => s.id === id);
            if (!student) return;

            const confirmed = await showConfirmModal("학생 삭제", `'${student.name}' 학생의 모든 기록을 삭제하시겠습니까?`);
            if (confirmed) {
                try {
                    await deleteDoc(doc(STUDENTS_COL, id));
                    await logActivity('system', student.name, `학생 삭제 (${student.name})`);
                    showToast(`${student.name} 학생이 삭제되었습니다.`, "info");
                } catch (err) {
                    console.error("Delete student error:", err);
                    showToast("학생 삭제 중 오류가 발생했습니다.", "error");
                }
            }
        };

        // Workout Certification Handler
        window.handleWorkout = async function(studentId) {
            const student = window.state.students.find(s => s.id === studentId);
            if (!student) return;

            const todayStr = getTodayString();
            if (student.lastWorkoutDate === todayStr) {
                const proceed = await showConfirmModal("중복 인증 확인", `'${student.name}' 학생은 오늘 이미 오운완 인증을 완료했습니다. 추가로 기록하시겠습니까?`);
                if (!proceed) return;
            }

            try {
                const docRef = doc(STUDENTS_COL, studentId);
                await updateDoc(docRef, {
                    workoutCount: increment(1),
                    lastWorkoutDate: todayStr
                });
                await logActivity('workout', student.name, `🔥 오운완 1회 인증! (누적 ${(student.workoutCount || 0) + 1}회)`);
                showToast(`🔥 ${student.name} 오운완 인증 완료!`, "success");
            } catch (err) {
                console.error("Workout log error:", err);
                showToast("운동 인증 저장 오류가 발생했습니다.", "error");
            }
        };

        // Reading Certification Handler
        window.handleReading = async function(studentId, addCount) {
            const student = window.state.students.find(s => s.id === studentId);
            if (!student || !addCount) return;

            try {
                const docRef = doc(STUDENTS_COL, studentId);
                await updateDoc(docRef, {
                    readingCount: increment(addCount)
                });
                await logActivity('reading', student.name, `📚 독서 ${addCount}권 인증! (누적 ${(student.readingCount || 0) + addCount}권)`);
                showToast(`📚 ${student.name} 독서 ${addCount}권 인증 완료!`, "success");
            } catch (err) {
                console.error("Reading log error:", err);
                showToast("독서 인증 저장 오류가 발생했습니다.", "error");
            }
        };

        window.handleReadingPrompt = async function(studentId) {
            const student = window.state.students.find(s => s.id === studentId);
            if (!student) return;

            const input = prompt(`${student.name} 학생이 추가로 읽은 책 권수를 입력하세요:`, "1");
            if (input !== null) {
                const count = parseInt(input);
                if (!isNaN(count) && count > 0) {
                    await handleReading(studentId, count);
                } else {
                    showToast("올바른 숫자를 입력해주세요.", "warning");
                }
            }
        };

        // Student Detail Modal Handlers
        window.openDetailModal = function(studentId) {
            const student = window.state.students.find(s => s.id === studentId);
            if (!student) return;

            document.getElementById('detail-student-name').textContent = student.name;
            
            const wCount = student.workoutCount || 0;
            const wTarget = student.targetWorkout || 50;
            const wPct = Math.min(100, Math.round((wCount / wTarget) * 100));

            const rCount = student.readingCount || 0;
            const rTarget = student.targetReading || 20;
            const rPct = Math.min(100, Math.round((rCount / rTarget) * 100));

            document.getElementById('detail-workout-stat').textContent = `${wCount} / ${wTarget}회`;
            document.getElementById('detail-workout-bar').style.width = `${wPct}%`;

            document.getElementById('detail-reading-stat').textContent = `${rCount} / ${rTarget}권`;
            document.getElementById('detail-reading-bar').style.width = `${rPct}%`;

            // Filter student activity history logs
            const studentLogs = (window.state.logs || []).filter(l => l.studentName === student.name);
            const historyList = document.getElementById('detail-history-list');

            if (studentLogs.length === 0) {
                historyList.innerHTML = `<div class="text-slate-400 text-center py-3">인증 기록이 아직 없습니다.</div>`;
            } else {
                historyList.innerHTML = studentLogs.map(l => `
                    <div class="flex items-center justify-between py-1 px-2 rounded bg-white border border-slate-100">
                        <span class="font-semibold text-slate-800">${escapeHtml(l.message)}</span>
                        <span class="text-[10px] text-slate-400">${formatDateTime(l.timestamp)}</span>
                    </div>
                `).join('');
            }

            document.getElementById('modal-detail').classList.remove('hidden');
        };

        window.closeDetailModal = function() {
            document.getElementById('modal-detail').classList.add('hidden');
        };

        // Helper: Write Activity Log
        async function logActivity(type, studentName, message) {
            try {
                await addDoc(LOGS_COL, {
                    type,
                    studentName,
                    message,
                    timestamp: new Date().toISOString()
                });
            } catch (err) {
                console.error("Log write error:", err);
            }
        }

        // Render Summary Dashboard Statistics & Milestone Rewards
        function renderStatsSummary() {
            const students = window.state.students;
            const totalStudents = students.length;
            const todayStr = getTodayString();

            document.getElementById('stat-student-count').textContent = `${totalStudents}명`;

            if (totalStudents === 0) {
                document.getElementById('stat-avg-progress').textContent = '0%';
                document.getElementById('stat-workout-today-count').textContent = '오늘 0명 달성';
                document.getElementById('stat-workout-total').textContent = '0회';
                document.getElementById('stat-workout-bar').style.width = '0%';
                document.getElementById('stat-reading-completers').textContent = '완주자 0명';
                document.getElementById('stat-reading-total').textContent = '0권';
                document.getElementById('stat-reading-bar').style.width = '0%';
                renderMilestoneRewards(0);
                return;
            }

            let totalWorkoutDone = 0;
            let totalWorkoutTarget = 0;
            let workoutDoneTodayCount = 0;

            let totalReadingDone = 0;
            let totalReadingTarget = 0;
            let readingCompletersCount = 0;

            let combinedProgressSum = 0;

            students.forEach(s => {
                const wCount = s.workoutCount || 0;
                const wTarget = s.targetWorkout || 50;
                const rCount = s.readingCount || 0;
                const rTarget = s.targetReading || 20;

                totalWorkoutDone += wCount;
                totalWorkoutTarget += wTarget;
                if (s.lastWorkoutDate === todayStr) workoutDoneTodayCount++;

                totalReadingDone += rCount;
                totalReadingTarget += rTarget;
                if (rCount >= rTarget) readingCompletersCount++;

                const wProg = Math.min(100, (wCount / wTarget) * 100);
                const rProg = Math.min(100, (rCount / rTarget) * 100);
                combinedProgressSum += (wProg + rProg) / 2;
            });

            const avgProgress = Math.round(combinedProgressSum / totalStudents);
            const workoutPct = Math.min(100, Math.round((totalWorkoutDone / (totalWorkoutTarget || 1)) * 100));
            const readingPct = Math.min(100, Math.round((totalReadingDone / (totalReadingTarget || 1)) * 100));

            document.getElementById('stat-avg-progress').textContent = `${avgProgress}%`;
            document.getElementById('stat-workout-today-count').textContent = `오늘 ${workoutDoneTodayCount}명 달성`;
            document.getElementById('stat-workout-total').textContent = `${totalWorkoutDone}회`;
            document.getElementById('stat-workout-bar').style.width = `${workoutPct}%`;

            document.getElementById('stat-reading-completers').textContent = `완주자 ${readingCompletersCount}명`;
            document.getElementById('stat-reading-total').textContent = `${totalReadingDone}권`;
            document.getElementById('stat-reading-bar').style.width = `${readingPct}%`;

            renderMilestoneRewards(avgProgress);
        }

        // Render Classroom Milestone Rewards Cards
        function renderMilestoneRewards(avgProgress) {
            const container = document.getElementById('reward-milestone-list');
            if (!container) return;

            const milestones = [25, 50, 75, 100];
            const rewards = window.state.rewards;

            container.innerHTML = milestones.map(m => {
                const isUnlocked = avgProgress >= m;
                const title = rewards[m] || `${m}% 보상`;

                return `
                    <div class="rounded-xl p-3 backdrop-blur-md border transition-all ${
                        isUnlocked 
                            ? 'bg-white text-slate-900 border-white shadow-md scale-105 ring-2 ring-amber-300' 
                            : 'bg-white/10 text-white/80 border-white/20'
                    }">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-[11px] font-extrabold tracking-wider uppercase ${isUnlocked ? 'text-amber-600' : 'text-amber-200'}">
                                ${m}% 달성
                            </span>
                            ${isUnlocked 
                                ? `<span class="bg-amber-500 text-white text-[10px] font-black px-1.5 py-0.5 rounded-full flex items-center gap-1"><i class="fa-solid fa-check"></i> 해제됨</span>` 
                                : `<span class="text-[10px] text-white/60"><i class="fa-solid fa-lock mr-1"></i>잠김</span>`
                            }
                        </div>
                        <p class="text-xs font-bold leading-snug line-clamp-2 ${isUnlocked ? 'text-slate-900' : 'text-white'}">
                            ${escapeHtml(title)}
                        </p>
                    </div>
                `;
            }).join('');
        }

        // Render Goal Completers Showcase (Hall of Fame)
        function renderHallOfFame() {
            const students = window.state.students;

            const doubleList = [];
            const workoutList = [];
            const readingList = [];

            students.forEach(s => {
                const wDone = (s.workoutCount || 0) >= (s.targetWorkout || 50);
                const rDone = (s.readingCount || 0) >= (s.targetReading || 20);

                if (wDone && rDone) {
                    doubleList.push(s);
                } else if (wDone) {
                    workoutList.push(s);
                } else if (rDone) {
                    readingList.push(s);
                }
            });

            const totalCompleters = doubleList.length + workoutList.length + readingList.length;
            const badgeEl = document.getElementById('hall-of-fame-count-badge');
            if (badgeEl) badgeEl.textContent = `총 ${totalCompleters}명 달성`;

            document.getElementById('badge-count-double').textContent = `${doubleList.length}명`;
            document.getElementById('badge-count-workout').textContent = `${workoutList.length}명`;
            document.getElementById('badge-count-reading').textContent = `${readingList.length}명`;

            renderHallCategory('hall-list-double', doubleList, 'double');
            renderHallCategory('hall-list-workout', workoutList, 'workout');
            renderHallCategory('hall-list-reading', readingList, 'reading');
        }

        function renderHallCategory(elementId, studentArr, type) {
            const el = document.getElementById(elementId);
            if (!el) return;

            if (studentArr.length === 0) {
                el.innerHTML = `<div class="text-slate-400 text-center py-4 text-xs">아직 해당 달성자가 없습니다.</div>`;
                return;
            }

            el.innerHTML = studentArr.map(s => {
                let badgeStyle = '';
                let icon = '';

                if (type === 'double') {
                    badgeStyle = 'bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold';
                    icon = '<i class="fa-solid fa-crown text-amber-200 mr-1"></i>';
                } else if (type === 'workout') {
                    badgeStyle = 'bg-orange-100 text-orange-800 font-semibold';
                    icon = '<i class="fa-solid fa-dumbbell mr-1 text-orange-500"></i>';
                } else {
                    badgeStyle = 'bg-emerald-100 text-emerald-800 font-semibold';
                    icon = '<i class="fa-solid fa-book mr-1 text-emerald-500"></i>';
                }

                return `
                    <div class="flex items-center justify-between p-2 rounded-lg bg-white border border-slate-100 shadow-2xs">
                        <span class="font-bold text-slate-800 hover:text-indigo-600 cursor-pointer" onclick="openDetailModal('${s.id}')">
                            ${icon} ${escapeHtml(s.name)}
                        </span>
                        <span class="text-[10px] px-2 py-0.5 rounded-md ${badgeStyle}">
                            100% 완주!
                        </span>
                    </div>
                `;
            }).join('');
        }

        // Open Rewards Modal
        window.openRewardsModal = function() {
            const rewards = window.state.rewards;
            document.getElementById('reward-25').value = rewards[25] || '';
            document.getElementById('reward-50').value = rewards[50] || '';
            document.getElementById('reward-75').value = rewards[75] || '';
            document.getElementById('reward-100').value = rewards[100] || '';
            document.getElementById('modal-rewards').classList.remove('hidden');
        };

        window.closeRewardsModal = function() {
            document.getElementById('modal-rewards').classList.add('hidden');
        };

        window.handleSaveRewards = async function(e) {
            e.preventDefault();
            const updatedRewards = {
                25: document.getElementById('reward-25').value.trim(),
                50: document.getElementById('reward-50').value.trim(),
                75: document.getElementById('reward-75').value.trim(),
                100: document.getElementById('reward-100').value.trim()
            };

            try {
                await setDoc(SETTINGS_DOC, updatedRewards, { merge: true });
                window.state.rewards = updatedRewards;
                renderStatsSummary();
                closeRewardsModal();
                showToast("학급 마일스톤 보상이 성공적으로 저장되었습니다.", "success");
            } catch (err) {
                console.error("Error saving rewards:", err);
                showToast("보상 설정 저장 중 오류가 발생했습니다.", "error");
            }
        };

        // Update Teacher UI Controls
        function updateTeacherModeUI() {
            const isTeacher = window.state.isTeacherMode;
            const btnStudent = document.getElementById('btn-mode-student');
            const btnTeacher = document.getElementById('btn-mode-teacher');
            const btnAddStudent = document.getElementById('btn-add-student');
            const btnEditRewards = document.getElementById('btn-edit-rewards');
            const historyPanel = document.getElementById('teacher-history-panel');

            if (isTeacher) {
                if (btnTeacher) btnTeacher.className = "px-3 py-1.5 rounded-md transition-all shadow-sm bg-indigo-600 text-white font-semibold";
                if (btnStudent) btnStudent.className = "px-3 py-1.5 rounded-md transition-all text-slate-600 hover:text-slate-900";
                if (btnAddStudent) { btnAddStudent.classList.remove('hidden'); btnAddStudent.classList.add('flex'); }
                if (btnEditRewards) { btnEditRewards.classList.remove('hidden'); btnEditRewards.classList.add('flex'); }
                if (historyPanel) historyPanel.classList.remove('hidden');
            } else {
                if (btnStudent) btnStudent.className = "px-3 py-1.5 rounded-md transition-all shadow-sm bg-white text-slate-800 font-semibold";
                if (btnTeacher) btnTeacher.className = "px-3 py-1.5 rounded-md transition-all text-slate-600 hover:text-slate-900";
                if (btnAddStudent) { btnAddStudent.classList.add('hidden'); btnAddStudent.classList.remove('flex'); }
                if (btnEditRewards) { btnEditRewards.classList.add('hidden'); btnEditRewards.classList.remove('flex'); }
                if (historyPanel) historyPanel.classList.add('hidden');
            }

            renderStudentList();
        }

        window.setFilter = function(filter) {
            window.state.currentFilter = filter;
            document.querySelectorAll('.filter-tab').forEach(btn => {
                btn.className = "filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors whitespace-nowrap";
            });

            const activeBtn = document.getElementById(`filter-btn-${filter}`);
            if (activeBtn) {
                activeBtn.className = "filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-white transition-colors whitespace-nowrap";
            }

            renderStudentList();
        };

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');

            let bgClass = 'bg-slate-800 text-white';
            if (type === 'success') bgClass = 'bg-emerald-600 text-white';
            if (type === 'error') bgClass = 'bg-rose-600 text-white';
            if (type === 'warning') bgClass = 'bg-amber-500 text-white';

            toast.className = `pointer-events-auto flex items-center px-4 py-3 rounded-xl shadow-lg text-xs font-bold transition-all transform translate-y-2 opacity-0 ${bgClass}`;
            toast.innerHTML = `<span>${escapeHtml(message)}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function showConfirmModal(title, message) {
            return new Promise((resolve) => {
                document.getElementById('dialog-title').textContent = title;
                document.getElementById('dialog-message').textContent = message;
                document.getElementById('modal-custom-dialog').classList.remove('hidden');

                window.state.dialogCallback = (result) => {
                    document.getElementById('modal-custom-dialog').classList.add('hidden');
                    resolve(result);
                };
            });
        }

        window.closeCustomDialog = function(result) {
            if (window.state.dialogCallback) {
                window.state.dialogCallback(result);
                window.state.dialogCallback = null;
            }
        };

        // Helper Utility Functions
        function getTodayString() {
            const d = new Date();
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function formatDateTime(isoString) {
            if (!isoString) return '';
            const d = new Date(isoString);
            return `${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        // Initialize on Window Load
        window.addEventListener('DOMContentLoaded', () => {
            initApp();
        });
    </script>
</body>
</html>
